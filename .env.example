# ==============================================================================
# VICE CITY SPORTS COMPLEX — CONFIGURACIÓN DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Copia este archivo como .env.local y .env en la raíz del proyecto:
#   Windows (PowerShell): Copy-Item .env.example .env.local; Copy-Item .env.local .env
#   Linux / macOS / Bash: cp .env.example .env.local && cp .env.local .env
#
# REGLAS DE SEGURIDAD:
# 1. NUNCA confirmes archivos .env o .env.local con credenciales reales en Git.
# 2. Las variables con prefijo NEXT_PUBLIC_ se exponen al navegador (código cliente).
# 3. Las variables sin prefijo NEXT_PUBLIC_ son estrictamente privadas del servidor.
# ==============================================================================


# ==============================================================================
# 1. BASE DE DATOS (PostgreSQL en Supabase + Prisma ORM) — [OBLIGATORIO]
# ==============================================================================

# Cadena de conexión con Transaction Pooler (puerto 6543) y pgbouncer=true.
# Utilizada en runtime por Next.js para ejecutar consultas y transacciones atómicas.
# Formato: postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[TU_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Cadena de conexión directa (Session Pooler, puerto 5432).
# REQUERIDA por Prisma CLI para introspección y migraciones (npm run db:pull, prisma migrate).
# Formato: postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[TU_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"


# ==============================================================================
# 2. CLIENTE SUPABASE (API & Autenticación de Supabase) — [OBLIGATORIO]
# ==============================================================================

# URL pública de la instancia de Supabase (sin barra final '/').
# Se obtiene en: Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"

# Clave anónima pública de Supabase (Anon Key / Publishable Key).
# Accesible de forma segura en navegador y servidor bajo políticas de Row Level Security (RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# [OPCIONAL / AVANZADO] Clave de servicio administrativo con bypass total de RLS.
# NUNCA exponer en cliente ni asignar a variables con prefijo NEXT_PUBLIC_.
# Solo para scripts de mantenimiento o automatizaciones backend.
# SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."


# ==============================================================================
# 3. AUTENTICACIÓN Y SESIONES (NextAuth.js v4 / JWT) — [OBLIGATORIO]
# ==============================================================================

# Secreto criptográfico maestro para firmar y cifrar tokens JWT y cookies de sesión.
# Obligatorio en producción (la app lanza excepción si no está configurado).
# Generar un valor seguro con: openssl rand -base64 32
NEXTAUTH_SECRET="tu-clave-secreta-generada-con-openssl-base64-32"

# Alias alternativo soportado por el middleware (opcional si NEXTAUTH_SECRET está definido).
# JWT_SECRET="tu-clave-secreta-jwt-de-respaldo"

# URL canónica base de la aplicación para callbacks y redirecciones de NextAuth.
# En desarrollo local: http://localhost:3000
# En producción: https://tudominio.com
NEXTAUTH_URL="http://localhost:3000"

# URL pública de la aplicación. Se usa para construir enlaces de correo
# (confirmación/recuperación), callbacks de Stripe y metadata de la app.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cabeceras de autenticación simulada (x-user-role / x-user-id / x-mock-role).
# Falsificables: SOLO para pruebas locales y api-tester. Deshabilitado por
# defecto. NUNCA habilitar en producción.
#ENABLE_MOCK_AUTH_HEADERS="true"


# ==============================================================================
# 4. PROVEEDORES DE IDENTIDAD FEDERADA (Google OAuth 2.0) — [OPCIONAL]
# ==============================================================================
# Requerido únicamente para habilitar "Iniciar sesión con Google" (HU05-B).
# Guía paso a paso: docs/GOOGLE_OAUTH_SETUP_GUIDE.md
# Configurar en: Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Callback URI requerido en Google Console:
#   - Desarrollo: http://localhost:3000/api/auth/callback/google
#   - Producción: https://tudominio.com/api/auth/callback/google

# GOOGLE_CLIENT_ID="tu-google-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="tu-google-client-secret"


# ==============================================================================
# 5. PASARELA DE PAGOS (Stripe en Modo Test - FT-05) — [REQUERIDO PARA PAGOS]
# ==============================================================================
# Requerido para checkout con tarjeta (HU23) y confirmación por webhook (HU24).
# Obtener claves en: Stripe Dashboard > Developers > API keys (modo Test activo).

# Clave pública de Stripe para inicializar Stripe Elements en el navegador.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_tu_stripe_publishable_key"

# Clave secreta privada para llamadas al SDK de Stripe desde el servidor.
STRIPE_SECRET_KEY="sk_test_tu_stripe_secret_key"

# Secreto de firma del webhook para validar 'stripe-signature' en POST /api/payments/webhook.
# En desarrollo local con Stripe CLI, obtener ejecutando:
#   stripe listen --forward-to localhost:3000/api/payments/webhook
STRIPE_WEBHOOK_SECRET="whsec_tu_stripe_webhook_secret"


# ==============================================================================
# 6. CORREO ELECTRÓNICO (HU03-B Confirmación / HU04-B Recuperación / Tickets)
# ==============================================================================
# El sistema soporta proveedores desacoplados (IEmailSender):
# - Desarrollo / Tests: Si no se configuran credenciales, el sistema utiliza
#   automáticamente ConsoleEmailSender, imprimiendo el enlace y token en la consola.
# - Opción A (Resend API): Configurar RESEND_API_KEY y EMAIL_FROM (https://resend.com).
# - Opción B (SMTP): Configurar SMTP_HOST, SMTP_PORT, etc. (Mailtrap, Gmail, SES).

# Opción A: Resend API
# RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwxyz"

# Opción B: Proveedor SMTP tradicional
# SMTP_HOST="sandbox.smtp.mailtrap.io"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="tu-usuario-smtp"
# SMTP_PASS="tu-password-smtp"

# Dirección del remitente para correos salientes
# EMAIL_FROM="Vice City <onboarding@resend.dev>"


# ==============================================================================
# 7. SCRIPTS DE SIEMBRA Y ADMINISTRADOR INICIAL (npm run db:seed:admin) — [OPCIONAL]
# ==============================================================================
# Variables consumidas por scripts/seed-admin.mjs para crear el superusuario inicial.
# ADMIN_SEED_PASSWORD es OBLIGATORIA en todos los entornos (mínimo 12 caracteres) y no tiene
# valor por defecto: defínela solo en tu .env local, nunca la subas al repositorio.

ADMIN_SEED_EMAIL="admin@vicecity.com"
ADMIN_SEED_NAME="Administrador Principal"
ADMIN_SEED_PASSWORD="<define-una-contraseña-segura-de-12+-caracteres>"
