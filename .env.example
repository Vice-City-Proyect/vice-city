# ==========================================
# BASE DE DATOS (Supabase + Prisma) - DEV 1
# ==========================================
# Cadena con Transaction Pooler (puerto 6543) para Next.js / serverless
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Cadena de conexión directa (puerto 5432) requerida por Prisma para migraciones (npx prisma migrate)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ==========================================
# CREDENCIALES DE SUPABASE - DEV 1
# ==========================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL del proyecto Supabase (pública)
NEXT_PUBLIC_SUPABASE_URL=""

# Llave anónima pública de Supabase (accesible en front y back)
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Llave de administración / Service Role (NUNCA exponer en cliente, solo backend)
#SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ==========================================
# AUTENTICACIÓN (FT-01: NextAuth / JWT / Google OAuth) - DEV 2 & DEV 3
# ==========================================
# Secreto obligatorio para firmar y cifrar tokens/sesiones (generar con: openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL="http://localhost:3000"

# Credenciales de Google Cloud Console para Login con Google (Sprint 1)
#GOOGLE_CLIENT_ID="tu-google-client-id.apps.googleusercontent.com"
#GOOGLE_CLIENT_SECRET="tu-google-client-secret"

# ==========================================
# PASARELA DE PAGOS (Stripe Test - Sprint 2)
# ==========================================
#NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
#STRIPE_SECRET_KEY="sk_test_..."
#STRIPE_WEBHOOK_SECRET="whsec_..."