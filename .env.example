# ==========================================
# BASE DE DATOS (Supabase + Prisma) - DEV 1
# ==========================================
# Cadena con Transaction Pooler (puerto 6543) para Next.js / serverless
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Cadena de conexión directa (puerto 5432) requerida por Prisma para migraciones (npx prisma migrate)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ==========================================
# CREDENCIALES DE SUPABASE - DEV 1
# ==========================================
# URL del proyecto Supabase (pública)
NEXT_PUBLIC_SUPABASE_URL=""

# Llave pública de Supabase (accesible en front y back).
# Supabase legacy la llama "anon key"; la nueva UI la llama "publishable key".
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
#NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Llave de administración / Service Role (NUNCA exponer en cliente, solo backend)
#SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ==========================================
# AUTENTICACIÓN (FT-01: NextAuth / JWT / Google OAuth) - DEV 2 & DEV 3
# ==========================================
# Secreto obligatorio para firmar y cifrar tokens/sesiones (generar con: openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL="http://localhost:3000"

# URL pública de la aplicación. Se usa para construir enlaces de correo
# (confirmación/recuperación), success/cancel de Stripe y metadata de la app.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cabeceras de autenticación simulada (x-user-role / x-user-id / x-mock-role).
# Falsificables: SOLO para pruebas locales y api-tester. Deshabilitado por
# defecto. NUNCA habilitar en producción.
#ENABLE_MOCK_AUTH_HEADERS="true"

# Credenciales de Google Cloud Console para Login con Google (Sprint 1).
# Si NO se definen, el proveedor Google no se registra y el botón se oculta
# (el login por credenciales sigue funcionando).
# URI de redirección autorizada en Google Cloud (local):
#   http://localhost:3000/api/auth/callback/google
# (producción: https://<dominio>/api/auth/callback/google)
#GOOGLE_CLIENT_ID="tu-google-client-id.apps.googleusercontent.com"
#GOOGLE_CLIENT_SECRET="tu-google-client-secret"

# ==========================================
# PASARELA DE PAGOS (Stripe Test - Sprint 2)
# ==========================================
#NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
#STRIPE_SECRET_KEY="sk_test_..."
#STRIPE_WEBHOOK_SECRET="whsec_..."

# ==========================================
# CORREO ELECTRÓNICO (SMTP - Sprint 2)
# ==========================================
# Proveedor SMTP para confirmación de correo, recuperación de contraseña y
# envío de tickets. Si SMTP_HOST no está definido, los correos se imprimen en
# consola (modo desarrollo). Ejemplos: Mailtrap, Gmail, Amazon SES, Resend SMTP.
#SMTP_HOST="sandbox.smtp.mailtrap.io"
#SMTP_PORT="587"
#SMTP_SECURE="false"
#SMTP_USER="tu-usuario-smtp"
#SMTP_PASS="tu-password-smtp"
#EMAIL_FROM="Vice City <no-reply@vicecity.club>"