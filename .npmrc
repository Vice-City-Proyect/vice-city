# ==============================================================================
# Política de Dependencias Congeladas y Seguridad - Vice City
# ==============================================================================
# 1. Guarda siempre la versión exacta instalada sin prefijos de rango (^ o ~)
save-exact=true

# 2. Asegura que package-lock.json siempre esté activo y sincronizado
package-lock=true

# 3. Forzar el cumplimiento estricto de las versiones de node/npm especificadas
engine-strict=true

