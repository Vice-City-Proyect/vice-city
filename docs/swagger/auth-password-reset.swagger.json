{
  "openapi": "3.0.3",
  "info": {
    "title": "Vice City API - Auth Module (Password Reset)",
    "version": "1.0.0",
    "description": "Especificación Swagger/OpenAPI para los endpoints de solicitud y restablecimiento de contraseña (HU04-B)."
  },
  "paths": {
    "/api/auth/forgot-password": {
      "post": {
        "summary": "Solicitar enlace de recuperación de contraseña",
        "description": "Recibe el correo del usuario, valida que exista una cuenta activa, genera un token criptográfico seguro de un solo uso con vigencia de 1 hora y despacha el correo con el enlace de recuperación.",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "additionalProperties": false,
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "usuario@ejemplo.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Enlace de recuperación despachado exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "Se ha enviado un enlace de recuperación a tu correo electrónico." }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Formato de correo inválido, cuerpo vacío o campos extra no permitidos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": false },
                    "error": { "type": "string", "example": "VALIDATION_ERROR" },
                    "message": { "type": "string", "example": "Datos de solicitud inválidos" },
                    "details": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "field": { "type": "string", "example": "email" },
                          "message": { "type": "string", "example": "El formato del correo electrónico es inválido" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No existe una cuenta registrada con el correo electrónico proporcionado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": false },
                    "error": { "type": "string", "example": "USER_NOT_FOUND" },
                    "message": { "type": "string", "example": "No existe una cuenta registrada con el correo electrónico proporcionado." }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": false },
                    "error": { "type": "string", "example": "INTERNAL_SERVER_ERROR" },
                    "message": { "type": "string", "example": "Ocurrió un error interno en el servidor" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/reset-password": {
      "post": {
        "summary": "Restablecer contraseña con token de recuperación",
        "description": "Recibe el token y la nueva contraseña, valida fortaleza mínima (8 caracteres), ejecuta la transacción atómica en la BD invalidando el token y actualizando la contraseña con hash seguro (bcrypt).",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["token", "newPassword"],
                "additionalProperties": false,
                "properties": {
                  "token": {
                    "type": "string",
                    "description": "Token de recuperación recibido en el enlace",
                    "example": "vcp_token_abc123xyz789"
                  },
                  "newPassword": {
                    "type": "string",
                    "format": "password",
                    "minLength": 8,
                    "description": "Nueva contraseña (mínimo 8 caracteres)",
                    "example": "NuevaContraseñaSegura123!"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Contraseña restablecida exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "Tu contraseña ha sido restablecida exitosamente." }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Token inválido, contraseña débil (< 8 chars), campos extra o JSON malformado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": false },
                    "error": { "type": "string", "example": "WEAK_PASSWORD" },
                    "message": { "type": "string", "example": "La nueva contraseña debe tener al menos 8 caracteres." }
                  }
                },
                "examples": {
                  "weakPassword": {
                    "summary": "Contraseña débil",
                    "value": {
                      "success": false,
                      "error": "WEAK_PASSWORD",
                      "message": "La nueva contraseña debe tener al menos 8 caracteres."
                    }
                  },
                  "invalidToken": {
                    "summary": "Token inválido o ya utilizado",
                    "value": {
                      "success": false,
                      "error": "INVALID_TOKEN",
                      "message": "El enlace de recuperación no es válido o ya fue utilizado."
                    }
                  }
                }
              }
            }
          },
          "410": {
            "description": "Token de recuperación expirado (superó ventana de 1 hora)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": false },
                    "error": { "type": "string", "example": "TOKEN_EXPIRED" },
                    "message": { "type": "string", "example": "El enlace de recuperación ha expirado. Por favor, solicita uno nuevo." }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": false },
                    "error": { "type": "string", "example": "INTERNAL_SERVER_ERROR" },
                    "message": { "type": "string", "example": "Ocurrió un error interno en el servidor" }
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Validar estado de vigencia del token de recuperación (UI Pre-check)",
        "description": "Permite a la interfaz de usuario verificar si el token recibido en la URL sigue activo antes de desplegar el formulario de nueva contraseña.",
        "tags": ["Auth"],
        "parameters": [
          {
            "in": "query",
            "name": "token",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Token de recuperación a verificar",
            "example": "vcp_token_abc123xyz789"
          }
        ],
        "responses": {
          "200": {
            "description": "Token vigente y válido para su consumo",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "Token de recuperación válido." },
                    "data": {
                      "type": "object",
                      "properties": {
                        "isValid": { "type": "boolean", "example": true }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Token no encontrado o ya consumido",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": false },
                    "error": { "type": "string", "example": "TOKEN_ALREADY_USED" },
                    "message": { "type": "string", "example": "El token de recuperación ya fue utilizado." },
                    "data": {
                      "type": "object",
                      "properties": {
                        "isValid": { "type": "boolean", "example": false },
                        "reason": { "type": "string", "example": "ALREADY_USED" }
                      }
                    }
                  }
                }
              }
            }
          },
          "410": {
            "description": "Token de recuperación expirado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": false },
                    "error": { "type": "string", "example": "TOKEN_EXPIRED" },
                    "message": { "type": "string", "example": "El enlace de recuperación ha expirado." },
                    "data": {
                      "type": "object",
                      "properties": {
                        "isValid": { "type": "boolean", "example": false },
                        "reason": { "type": "string", "example": "EXPIRED" }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": false },
                    "error": { "type": "string", "example": "INTERNAL_SERVER_ERROR" },
                    "message": { "type": "string", "example": "Ocurrió un error interno en el servidor" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
