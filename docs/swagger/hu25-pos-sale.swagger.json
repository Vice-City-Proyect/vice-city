{
  "openapi": "3.0.3",
  "info": {
    "title": "Vice City - Módulo POS Empleado (HU25)",
    "description": "Especificación de API para ventas presenciales en taquilla POS con emisión inmediata de tickets QR (RN-017).",
    "version": "1.0.0"
  },
  "paths": {
    "/api/pos/sale": {
      "post": {
        "summary": "Registrar venta presencial en taquilla POS",
        "description": "Permite al empleado con rol TICKET_SELLER o ADMIN registrar una venta presencial (en efectivo o tarjeta), validando aforo, horario y mantenimiento semanal. Crea la reserva confirmada, registra el pago y emite el ticket con código QR seguro (RN-017, RN-010).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "sellerId",
                  "clientName",
                  "clientId",
                  "serviceId",
                  "startAt",
                  "endAt",
                  "quantity",
                  "paymentMethod"
                ],
                "additionalProperties": false,
                "properties": {
                  "sellerId": {
                    "type": "string",
                    "format": "uuid",
                    "description": "UUID del empleado vendedor (rol TICKET_SELLER o ADMIN)",
                    "example": "a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d"
                  },
                  "clientName": {
                    "type": "string",
                    "minLength": 2,
                    "description": "Nombre completo del cliente en taquilla",
                    "example": "Carlos Mendoza"
                  },
                  "clientId": {
                    "type": "string",
                    "minLength": 4,
                    "description": "Documento de identidad o cédula del cliente",
                    "example": "1020304050"
                  },
                  "serviceId": {
                    "type": "string",
                    "format": "uuid",
                    "description": "UUID del servicio deportivo",
                    "example": "b2c3d4e5-f6a7-8b9c-0d1e-2f3a4b5c6d7e"
                  },
                  "startAt": {
                    "type": "string",
                    "format": "date-time",
                    "example": "2026-10-15T10:00:00-05:00"
                  },
                  "endAt": {
                    "type": "string",
                    "format": "date-time",
                    "example": "2026-10-15T11:00:00-05:00"
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1,
                    "example": 2
                  },
                  "paymentMethod": {
                    "type": "string",
                    "enum": ["cash", "card"],
                    "description": "Método de pago presencial recibido en taquilla",
                    "example": "cash"
                  },
                  "clientPhone": {
                    "type": "string",
                    "example": "3001234567"
                  },
                  "notes": {
                    "type": "string",
                    "example": "Venta rápida en taquilla"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Venta registrada, pagada y ticket QR emitido exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "Venta presencial registrada exitosamente y ticket generado" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "bookingId": { "type": "string", "format": "uuid" },
                        "ticketId": { "type": "string", "format": "uuid" },
                        "ticketCode": { "type": "string", "example": "A1B2C3D4E5F6..." },
                        "paymentId": { "type": "string", "format": "uuid" },
                        "amount": { "type": "number", "example": 4000 },
                        "currency": { "type": "string", "example": "COP" },
                        "clientName": { "type": "string", "example": "Carlos Mendoza" },
                        "clientId": { "type": "string", "example": "1020304050" },
                        "serviceName": { "type": "string", "example": "Piscina Adultos" },
                        "startAt": { "type": "string", "format": "date-time" },
                        "endAt": { "type": "string", "format": "date-time" },
                        "quantity": { "type": "integer", "example": 2 },
                        "paymentMethod": { "type": "string", "example": "cash" },
                        "status": { "type": "string", "example": "confirmed" },
                        "sellerId": { "type": "string", "format": "uuid" },
                        "isStartedSlotPurchased": { "type": "boolean", "example": false }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Parámetros inválidos, franja finalizada o fuera de horario",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": false },
                    "message": { "type": "string" },
                    "error": { "type": "object" }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Acceso denegado: El vendedor no posee el rol TICKET_SELLER o ADMIN",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": false },
                    "message": { "type": "string", "example": "Acceso denegado: solo el personal con rol TICKET_SELLER o ADMIN puede registrar ventas en el POS." },
                    "error": { "type": "object", "properties": { "code": { "type": "string", "example": "FORBIDDEN_POS_ACCESS" } } }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Servicio o vendedor no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": false },
                    "message": { "type": "string" },
                    "error": { "type": "object" }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Aforo insuficiente para la cantidad solicitada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": false },
                    "message": { "type": "string", "example": "Aforo insuficiente para la cantidad solicitada en la franja seleccionada." },
                    "error": { "type": "object", "properties": { "code": { "type": "string", "example": "POS_CAPACITY_EXCEEDED" } } }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Día de mantenimiento semanal cerrado (Lunes o Martes festivo)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": false },
                    "message": { "type": "string", "example": "No hay servicio disponible por mantenimiento semanal." },
                    "error": { "type": "object", "properties": { "code": { "type": "string", "example": "POS_MAINTENANCE_DAY_CLOSED" } } }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
